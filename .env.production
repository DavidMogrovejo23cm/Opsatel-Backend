# ============================================================================
# OPSATEL ISP - Production Configuration
# ============================================================================
# Para deployar en Ubuntu. Copiar a /home/opsatel/.env
# Requiere: source .env antes de ejecutar servicios

# ============================================================================
# BASE DE DATOS
# ============================================================================
DATABASE_URL=mysql+pymysql://root:password@localhost/opsatel
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=opsatel
MYSQL_HOST=localhost
MYSQL_PORT=3306

# ============================================================================
# OLT PROVISIONING - OLT Configuration
# ============================================================================
# Las OLTs se configuran principalmente via DB (tabla olt_config)
# Pero aquí van los valores por defecto/fallback

# OLT 1: Huawei BAÑOS
OLT_BAÑOS_HOST=192.168.1.100
OLT_BAÑOS_PORT=23
OLT_BAÑOS_USERNAME=admin
OLT_BAÑOS_PASSWORD=admin123
OLT_BAÑOS_TIMEOUT=30
OLT_BAÑOS_MAX_RETRIES=3

# OLT 2: Huawei SAYAUSI
OLT_SAYAUSI_HOST=192.168.1.101
OLT_SAYAUSI_PORT=23
OLT_SAYAUSI_USERNAME=admin
OLT_SAYAUSI_PASSWORD=admin123
OLT_SAYAUSI_TIMEOUT=30
OLT_SAYAUSI_MAX_RETRIES=3

# ============================================================================
# OLT WORKER DAEMON Configuration
# ============================================================================
# Poll interval: Cada cuántos segundos verificar tareas pendientes
WORKER_ENABLED=true
WORKER_POLL_INTERVAL=1
WORKER_BATCH_SIZE=5
WORKER_STARTUP_DELAY=2
OLT_WORKER_AUTOSTART=true
OLT_HEALTH_CHECK_INTERVAL=30
OLT_MAC_LEARN_ATTEMPTS=1
OLT_LEASE_POLL_ATTEMPTS=1
WORKER_LOG_FILE=/var/log/opsatel/olt-worker.log
WORKER_PID_FILE=/var/run/opsatel-olt-worker.pid
WORKER_LOCK_FILE=/var/run/opsatel-olt-worker.lock

# Debug mode (aumenta logging)
DEBUG=false

# ============================================================================
# BACKEND - FastAPI Configuration
# ============================================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
BACKEND_RELOAD=false

# ============================================================================
# SEGURIDAD & JWT
# ============================================================================
SECRET_KEY=tu-clave-super-secreta-aqui-cambiar-en-produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# RUTAS Y PERMISOS
# ============================================================================
ADMIN_ROLE=administrador
TECH_ROLE=tecnico
INSTALLER_ROLE=instalador

# ============================================================================
# NOTIFICACIONES & LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=/var/log/opsatel

# Email para alertas (opcional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=opsatel@domain.com

# WhatsApp (si está integrado)
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# Inteligencia Artificial (SAM Chatbot)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Para activar/desactivar features sin redeployar
FEATURE_OLT_PROVISIONING=true
FEATURE_POWER_VERIFICATION=true
FEATURE_AUTO_ACTIVATION=true

# ============================================================================
# XUI PANEL CONFIGURATION (IPTV)
# ============================================================================
XUI_URL=http://172.30.0.3/bwfdVuGs
XUI_USERNAME=DAVIDOPSA
XUI_PASSWORD=OPSATEL.@#22

# ============================================================================
# PERFORMANCE
# ============================================================================
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE=3600
CACHE_TTL=300

# ============================================================================
# DEPLOYMENT
# ============================================================================
ENVIRONMENT=production
DOMAIN=opsatel.com
APP_NAME=OPSATEL ISP Management
VERSION=1.0.0
